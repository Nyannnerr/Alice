modules = ["python-3.12"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
build = ["sh", "-c", "python3 -m pip install --no-cache-dir -r requirements.txt"]
run = ["python3", "bot.py"]
deploymentTarget = "cloudrun"

[workflows]

[[workflows.workflow]]
name = "alice-hybrid"
mode = "sequential"
author = 25406977

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u bot.py"

[[workflows.workflow]]
name = "update"
mode = "sequential"
author = 25406977

[[workflows.workflow.tasks]]
task = "packager.installForLanguage"
args = "python3"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 10000
externalPort = 3000
